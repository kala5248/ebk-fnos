[
    {
        "stepTitle": "服务设置",
        "items": [
            {
                "type": "tips",
                "helpText": "ezBookkeeping 默认使用端口 8080。若该端口已被占用，可在此修改；安装完成后也可在应用中心“设置”中再次调整。"
            },
            {
                "type": "text",
                "field": "wizard_http_port",
                "label": "服务端口",
                "initValue": "8080",
                "rules": [
                    {
                        "required": true,
                        "message": "请填写服务端口"
                    },
                    {
                        "pattern": "^[0-9]{2,5}$",
                        "message": "端口需为 2-5 位数字"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "数据库设置",
        "items": [
            {
                "type": "tips",
                "helpText": "内置 SQLite 免配置，数据保存在应用数据目录；如需使用已有 MySQL / PostgreSQL，请选择对应类型并填写连接信息。"
            },
            {
                "type": "radio",
                "field": "wizard_db_type",
                "label": "数据库类型",
                "initValue": "sqlite3",
                "options": [
                    {
                        "label": "内置 SQLite（推荐，免配置）",
                        "value": "sqlite3"
                    },
                    {
                        "label": "MySQL",
                        "value": "mysql"
                    },
                    {
                        "label": "PostgreSQL",
                        "value": "postgres"
                    }
                ]
            },
            {
                "type": "text",
                "field": "wizard_db_host",
                "label": "数据库地址（host:port）",
                "initValue": "127.0.0.1:3306"
            },
            {
                "type": "text",
                "field": "wizard_db_name",
                "label": "数据库名",
                "initValue": "ezbookkeeping"
            },
            {
                "type": "text",
                "field": "wizard_db_user",
                "label": "数据库用户名",
                "initValue": "ezbookkeeping"
            },
            {
                "type": "password",
                "field": "wizard_db_passwd",
                "label": "数据库密码"
            },
            {
                "type": "tips",
                "helpText": "以上连接信息仅在选择 MySQL / PostgreSQL 时生效；使用 SQLite 时可留空。"
            }
        ]
    },
    {
        "stepTitle": "飞牛授权登录（可选）",
        "items": [
            {
                "type": "tips",
                "helpText": "启用后登录页会出现「使用飞牛账号登录」。需先在 fnOS 中注册一个 OAuth 客户端，并把客户端 ID（及密钥，如为机密客户端）填在下方；未填写客户端 ID 时本项自动关闭，不影响账号密码登录。"
            },
            {
                "type": "switch",
                "field": "wizard_enable_fnos_auth",
                "label": "启用飞牛账号授权登录",
                "initValue": "false"
            },
            {
                "type": "text",
                "field": "wizard_fnos_base_url",
                "label": "飞牛系统地址",
                "initValue": "http://127.0.0.1:5666"
            },
            {
                "type": "text",
                "field": "wizard_fnos_client_id",
                "label": "OAuth 客户端 ID"
            },
            {
                "type": "password",
                "field": "wizard_fnos_client_secret",
                "label": "OAuth 客户端密钥（公有客户端可留空）"
            }
        ]
    }
]