#!/bin/bash
set -u
MAIN="$(dirname "${TRIM_APPDEST}")/cmd/main"
LOG_FILE="${TRIM_TEMP_LOGFILE:-${TRIM_PKGVAR}/upgrade.log}"

# Stop the old instance, then wait for the service port to be released before
# the package manager replaces the target directory.
"${MAIN}" stop >/dev/null 2>&1 || true

CONF="${TRIM_PKGETC}/ezbookkeeping.ini"
PORT="$(grep -E '^http_port = ' "${CONF}" 2>/dev/null | head -n 1 | cut -d '=' -f 2 | tr -d ' ')"
if [ -n "${PORT}" ]; then
    for _ in $(seq 1 15); do
        if ! ss -ltn "sport = :${PORT}" 2>/dev/null | grep -q LISTEN; then
            break
        fi
        sleep 1
    done
fi

echo "upgrade_init completed for ${TRIM_APPNAME:-ebk-fnos} ${TRIM_OLD_APPVER:-unknown} -> ${TRIM_APPVER:-unknown}" >> "${LOG_FILE}" 2>/dev/null || true
exit 0
